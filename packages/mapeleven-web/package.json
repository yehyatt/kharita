{
  "name": "mapeleven",
  "version": "0.2.0",
  "description": "Open maps made simple: OpenStreetMap + MapLibre with Arabic-first styles, search and self-hostable tiles.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mapeleven.js",
  "module": "./dist/mapeleven.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/mapeleven.js" },
    "./style.css": "./dist/mapeleven.css"
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": { "maplibre-gl": "^6.16.0" },
  "devDependencies": {
    "maplibre-gl": "6.16.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "keywords": ["maps", "openstreetmap", "maplibre", "arabic", "rtl", "geocoding"]
}
