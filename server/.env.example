# Public hostname of this server (DNS A record must point here).
DOMAIN=maps.example.com
# Extra hostnames that 301-redirect to DOMAIN (www.DOMAIN always does). Space-separated, quoted.
REDIRECT_DOMAINS=""
# Bounding box for the tile extract: minLon,minLat,maxLon,maxLat. Default covers Jordan + GCC.
REGION_BBOX=34.0,12.0,60.5,33.5
REGION_NAME=mena
# Highest zoom kept in the extract (15 is street level; lower = smaller file).
MAX_ZOOM=15
# Photon search dumps, from https://download1.graphhopper.com/public/asia/
PHOTON_REGIONS="jordan arabian-peninsula"
PHOTON_VERSION=1.3.0
PHOTON_HEAP=2g

# Accounts and API keys (api service). SESSION_SECRET: openssl rand -hex 32
SESSION_SECRET=
# GitHub OAuth app (github.com/settings/developers), callback https://DOMAIN/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Free monthly limits per account, and searches per minute per IP without a key.
FREE_MAP_LOADS=50000
FREE_SEARCHES=50000
ANON_SEARCH_PER_MINUTE=120
