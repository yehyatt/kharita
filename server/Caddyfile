{$DOMAIN} {
	encode zstd gzip

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, OPTIONS"
	}

	# Vector tiles + TileJSON from go-pmtiles: /tiles/mena.json, /tiles/mena/{z}/{x}/{y}.mvt
	# Requests with ?key= are checked and counted by the api service first.
	handle /tiles/* {
		@keyed query key=*
		route {
			forward_auth @keyed api:8081 {
				uri /check
			}
			uri query -key
			uri strip_prefix /tiles
			reverse_proxy tiles:8080
		}
		header Cache-Control "public, max-age=86400"
	}

	# MapLibre styles: /styles/light-ar.json ... served by the api service, which puts
	# the key (?key=) on the tile URLs and counts map loads.
	handle /styles/* {
		reverse_proxy api:8081
	}

	# Accounts, keys and usage (dashboard at /account/).
	handle /api/* {
		reverse_proxy api:8081
	}
	handle /auth/* {
		reverse_proxy api:8081
	}

	# Fonts (glyph PBFs) and sprites
	handle_path /assets/* {
		root * /srv/assets
		file_server
		header Cache-Control "public, max-age=604800"
	}

	# Photon geocoder: /search/api?q=..., /search/reverse?lat=..&lon=..
	# The api service checks the key (or the per-IP limit without one) and counts the search.
	handle /search/* {
		route {
			forward_auth api:8081 {
				uri /check
			}
			uri query -key
			uri strip_prefix /search
			reverse_proxy search:2322
		}
	}

	# Valhalla routing: /routing/route?json=..., /routing/isochrone?json=...
	# Checked and counted like search (one route = one search).
	handle /routing/* {
		route {
			forward_auth api:8081 {
				uri /check
			}
			uri query -key
			uri strip_prefix /routing
			reverse_proxy routing:8002
		}
	}

	# Website, docs and the Explorer demo (website/deploy.sh uploads them to data/site).
	handle {
		root * /srv/site
		try_files {path} {path}/index.html {path}.html
		file_server
		@html path *.html */
		header @html Cache-Control "public, max-age=300"
		header /static/* Cache-Control "public, max-age=86400"
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

# www and any extra domains (REDIRECT_DOMAINS, space-separated) redirect to the main domain.
www.{$DOMAIN} {$REDIRECT_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}
